.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
dist/
build/
data/competition/*
!data/competition/.gitkeep
data/cache/*
!data/cache/.gitkeep
# Generated bulky artifacts stay out of git (captures, GEFFs, train dumps, logs, Kaggle CSVs).
outputs/*
!outputs/.gitkeep
!outputs/analysis/
!outputs/experiments/
!outputs/kaggle_submission/
!outputs/kaggle_submission/**

# Large Kaggle CSVs stay local + NFS; record path/sha256 in .agents/memory.md instead.
outputs/kaggle_submission/*.csv
outputs/kaggle_submission/**/*.csv

# Experiment dumps that are too large to version (not Kaggle deliverables)
outputs/experiments/**/predictions/
outputs/experiments/**/raw_geff/
outputs/experiments/**/*.npz
outputs/experiments/candidate_capture*/
outputs/experiments/**/candidate_edge_diagnostic.csv

artifacts/
*.parquet
.kaggle/

data/support/
data/tmp_*/
*.pth
*.whl
logs/
data/deepcenter/
*.pt
